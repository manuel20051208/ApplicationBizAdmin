# Desarrollo local: copia este archivo como `.env.local`.
# Esta variable no se versiona y hace que Next.js reenvíe /api/... al backend local.
BACKEND_API_URL=http://localhost:8080

# Producción: NO guardes la URL de Render en archivos del repositorio.
# Define BACKEND_API_URL=https://api-project-vh4u.onrender.com en Vercel
# (Environment Variables, scope Production). El navegador siempre usa /api/...
# y Next.js hace el proxy, sin CORS ni URL del backend en el bundle.

# NO definas NEXT_PUBLIC_API_URL: las NEXT_PUBLIC_* se inyectan en el bundle
# del navegador y quedan expuestas (Vercel muestra una advertencia). Solo existe el
# fallback en el código por compatibilidad con configuraciones antiguas.
# NEXT_PUBLIC_API_URL=https://api-project-vh4u.onrender.com

# Cloudinary (si se usa subida de imágenes desde el cliente hacia Cloudinary).
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
