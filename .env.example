# URL del backend Spring Boot — VARIABLE CANÓNICA (server-side, no expuesta al navegador).
# Defínela en Vercel como Environment Variable normal (scope Production).
# El navegador llama al mismo origen /api/... y Next.js reenvía con rewrites (sin CORS).
BACKEND_API_URL=https://api-project-vh4u.onrender.com

# NO definas NEXT_PUBLIC_API_URL en Vercel: las NEXT_PUBLIC_* se inyectan en el bundle
# del navegador y quedan expuestas (Vercel muestra una advertencia). Solo existe el
# fallback en el código por compatibilidad con configuraciones antiguas.
# NEXT_PUBLIC_API_URL=https://api-project-vh4u.onrender.com

# Cloudinary (si se usa subida de imágenes desde el cliente hacia Cloudinary).
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=